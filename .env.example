# ============================================================================
# Variables de entorno - Frontend (Vite + React)
# ============================================================================
# URL base de la API REST del backend (sin barra final).
# En desarrollo local copiar a .env con el puerto de tu servidor Spring Boot.
VITE_API_URL=https://tu-api-backend.ejemplo.com

# Si es true, el frontend utiliza los datos simulados de /src/mocks.
# En producción o al conectar con el backend real debe ser false.
VITE_USE_MOCKS=false

# ============================================================================
# Variables de entorno - Backend (Spring Boot + PostgreSQL)
# ============================================================================
DB_URL=jdbc:postgresql://tu_host_db:5432/tu_nombre_db
DB_USER=tu_usuario_db
DB_PASSWORD=tu_password_db
DB_HOST=tu_host_db
DB_PORT=5432
DB_NAME=tu_nombre_db

# Seguridad JWT y CORS
JWT_SECRET=reemplazar_por_clave_secreta_de_al_menos_32_caracteres_en_produccion
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=https://tu-frontend.ejemplo.com
