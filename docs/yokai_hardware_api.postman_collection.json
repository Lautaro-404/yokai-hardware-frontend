      "name": "01 - Autenticación y Usuarios",
      "item": [
        {
          "name": "01.1 - Registro Nuevo Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Retorna token y usuario con rol CLIENTE\", function () {",
                  "    pm.expect(data).to.have.property('token');",
                  "    pm.expect(data.token).to.be.a('string');",
                  "    pm.expect(data.usuario.rol).to.eql('CLIENTE');",
                  "});",
                  "if (data.token) {",
                  "    pm.collectionVariables.set(\"clientToken\", data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente Postman Runner\",\n  \"email\": \"cliente.runner_{{$timestamp}}@yokai.com\",\n  \"password\": \"Cliente123!\",\n  \"direccion\": \"Av. San Martín 850, San Rafael\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
